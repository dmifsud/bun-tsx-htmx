{
  "name": "bun-tsx-htmx",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run --hot ./src/server.ts\" \"bun run dev:vite\"",
    "dev:vite": "vite",
    "build": "vite build",
    "serve": "NODE_ENV=production bun --hot run ./src/server.ts",
    "build:css": "npx tailwindcss -i ./src/assets/styles.css -o ./dist/css/styles.css --watch"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "hono": "^4.5.0",
    "mongodb": "^6.8.0",
    "mongoose": "^8.6.0",
    "postcss": "^8.4.39",
    "preact-render-to-string": "^6.5.5",
    "tailwindcss": "^3.4.5",
    "vite": "^5.3.3"
  },
  "peerDependencies": {
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "htmx.org": "^2.0.1",
    "hyper-validate": "^0.0.3",
    "lit": "^3.1.4"
  }
}